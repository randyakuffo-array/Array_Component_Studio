{
  "name": "array-component-studio",
  "version": "1.1.0",
  "description": "Array Studio — local Electron app for embedded components and bulk user deletion.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --universal --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:win:nsis": "electron-builder --win nsis --publish never",
    "build:win:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.componentstudio.app",
    "productName": "Array Studio",
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**",
      "!figma-design*.tsx",
      "!figma-design.css"
    ],
    "extraResources": [],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "ArrayStudio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "ArrayStudio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Array Studio",
      "uninstallDisplayName": "Array Studio",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ArrayStudio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ArrayStudio-Portable.exe"
    }
  }
}
